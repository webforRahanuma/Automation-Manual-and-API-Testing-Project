				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response contains user data\", function () {\r",
							"    const users = pm.response.json();\r",
							"\r",
							"    pm.expect(users).to.be.an(\"array\");\r",
							"\r",
							"    pm.expect(users.length).to.be.greaterThan(0);\r",
							"});\r",
							"\r",
							"pm.test(\"Each user has id, name, and email\", function () {\r",
							"    const users = pm.response.json();\r",
							"\r",
							"    users.forEach(function (user) {\r",
							"        pm.expect(user).to.have.property(\"id\");\r",
							"        pm.expect(user).to.have.property(\"name\");\r",
							"        pm.expect(user).to.have.property(\"email\");\r",
							"    });\r",
							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"\r",
							"const userId = response[0].id;\r",
							"\r",
							"pm.environment.set(\"userId\", userId);\r",
							"\r",
							"const userPhone = response[0].phone;\r",
							"\r",
							"pm.environment.set(\"userPhone\", userPhone);"
						],
						"type": "text/javascript",
						"packages": {}
					}
